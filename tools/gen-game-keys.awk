# Generate npclient/game_keys.h from OpenTrack's
# "settings/facetracknoir supported games.csv":
#
#   awk -F';' -f tools/gen-game-keys.awk "facetracknoir supported games.csv" > npclient/game_keys.h
#
# Columns: No; Game Name; Game protocol; Supported since; Verified; By;
# INTERNATIONAL_ID; FTN_ID. Games "supported since" V160 get plain data. For
# the rest, FTN_ID's eleven hex bytes hold the key, in the order OpenTrack's
# csv.cpp reads them: bytes 5 4 3 2 then 9 8 7 6 (counting from 0).
BEGIN {
    print "/* Generated by tools/gen-game-keys.awk from OpenTrack's game table"
    print " * (ISC licence). Games not listed here get plain data. */"
    print ""
    print "static const struct {"
    print "    unsigned short id;"
    print "    const char *name;"
    print "    unsigned char key[8];"
    print "} scrambled_games[] = {"
}
NR > 1 && $4 != "V160" && length($8) == 22 {
    order = "5 4 3 2 9 8 7 6"
    split(order, idx, " ")
    key = ""
    for (i = 1; i <= 8; i++)
        key = key sprintf("%s0x%s", i > 1 ? ", " : "", substr($8, idx[i] * 2 + 1, 2))
    name = $2
    gsub(/\\/, "\\\\", name)
    gsub(/"/, "\\\"", name)
    printf "    {%s, \"%s\", {%s}},\n", $7, name, key
}
END { print "};" }
