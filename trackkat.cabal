cabal-version:      3.0
name:               trackkat
version:            0.1.0.0
synopsis:           Replacement driver and control software for the TrackIR 5
license:            MIT
author:             chreekat
maintainer:         b@chreekat.net
build-type:         Simple
extra-doc-files:    README.md

common shared
  default-language: Haskell2010
  ghc-options:      -Wall

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    TrackKat.Calibration
    TrackKat.Camera
    TrackKat.Config
    TrackKat.Frame
    TrackKat.GamePose
    TrackKat.Icon
    TrackKat.Linear
    TrackKat.Match
    TrackKat.Number
    TrackKat.Pose
    TrackKat.Protocol
    TrackKat.Response
    TrackKat.Stats
    TrackKat.Status
    TrackKat.Tracker
    TrackKat.USB
  build-depends:
    , array       ^>=0.5.8
    , async       ^>=2.2.6
    , base        ^>=4.22.0
    , bytestring  ^>=0.12.2
  c-sources:        cbits/usb_shim.c
  extra-libraries:  usb-1.0

  if os(windows)
    exposed-modules:
      TrackKat.Gui
      TrackKat.Windows
    c-sources:
      cbits/gui.c
      cbits/joystick.c
      cbits/npclient_common.c
      cbits/trackir.c
      cbits/windows.c
    include-dirs:    cbits
    extra-libraries: advapi32 gdi32 hid shell32 user32

-- trackkat's window, drawn with Dear ImGui in a GLFW window, on any
-- platform; a library of its own so that only the programs showing it link
-- ImGui and GLFW.
library window
  import:           shared
  hs-source-dirs:   window
  exposed-modules:
    TrackKat.Window
    TrackKat.Window.Curves
  other-modules:
    TrackKat.Window.Draw
    TrackKat.Window.GL
    TrackKat.Window.Style
  build-depends:
    , base
    , bindings-GLFW  ^>=3.3.9.3
    , bytestring     ^>=0.12.2
    , containers     ^>=0.8
    , dear-imgui     ^>=2.5.0
    , directory      ^>=1.3.10
    , filepath       ^>=1.5.4
    , GLFW-b         ^>=3.3.9.1
    , StateVar       ^>=1.2.2
    , stm            ^>=2.5.3
    , text           ^>=2.1.3
    , trackkat

  if os(windows)
    extra-libraries: opengl32

  else
    extra-libraries: GL

executable tirprobe
  import:           shared
  hs-source-dirs:   app/tirprobe
  main-is:          Main.hs
  ghc-options:      -threaded -rtsopts
  build-depends:
    , async
    , base
    , trackkat

executable trackkat
  import:           shared
  hs-source-dirs:   app/trackkat
  main-is:          Main.hs
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-T"
  build-depends:
    , async
    , base
    , directory
    , filepath
    , time
    , trackkat

  if !os(windows)
    buildable: False

-- The window driven by a scripted pose and status, for working on it and
-- taking screenshots without a camera, on any platform.
executable trackkat-window-demo
  import:           shared
  hs-source-dirs:   app/window-demo
  main-is:          Main.hs
  ghc-options:      -threaded
  build-depends:
    , async
    , base
    , trackkat
    , trackkat:window

test-suite tests
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  build-depends:
    , base
    , bytestring
    , trackkat
    , trackkat:window
