    Test.Frame
    Test.Gen
    Test.Gesture
    Test.Icons
    Test.Idle
    Test.Instances
    Test.Level
    Test.Linear
    Test.Lights
    Test.Match
    Test.Memory
    Test.Mount
    Test.Number
    Test.Old.Branch
    Test.Old.Clips
    Test.Old.Following
    Test.Old.Gen
    Test.Old.Instances
    Test.Old.Lights
    Test.Old.Match
    Test.Old.Memory
    Test.Old.Mount
    Test.Old.Scorecard
    Test.Old.Shape
    Test.Old.Simulation
    Test.Old.Tracker
    Test.Old.Tracker.Blobs
    Test.Old.Tracker.Choose
    Test.Old.Tracker.Follow
    Test.Old.Tracker.Judge
    Test.Old.Tracker.Kept
    Test.Old.Tracker.Layout
    Test.Old.Tracker.Sizes
    Test.Old.Tracker.Step
    Test.Old.Tracker.Trail
    Test.Old.Visibility
    Test.Pose
    Test.Protocol
    Test.Recording
    Test.Release
    Test.Response
    Test.Scorecard
    Test.Session
    Test.ServedGame
    Test.Shape
    Test.Shrink
    Test.Simulation
    Test.Stats
    Test.Term
    Test.Tracker
    Test.Tracker.Account
    Test.Tracker.Blobs
    Test.Tracker.Choose
    Test.Tracker.Follow
    Test.Tracker.Kept
    Test.Tracker.Known
    Test.Tracker.Layout
    Test.Tracker.Presence
    Test.Tracker.Reflectors
    Test.Tracker.Sizes
    Test.Tracker.Step
    Test.Tracker.Trail
    Test.Trackers
    Test.Tray
    Test.Updater
    Test.Visibility
    Test.World
  ghc-options:      "-with-rtsopts=-T"
  build-depends:
    , base
    , bytestring
    , directory
    , filepath
    , tasty
    , tasty-hunit
    , tasty-quickcheck
    , trackkat
    , trackkat:synth
    , zip-archive
