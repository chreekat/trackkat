cabal-version:      3.0
name:               trackkat
version:            0.1.0.0
synopsis:           Replacement driver and control software for the TrackIR 5
license:            MIT
author:             chreekat
maintainer:         b@chreekat.net
build-type:         Simple
extra-doc-files:    README.md

common shared
  default-language: Haskell2010
  ghc-options:      -Wall

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    TrackKat.Belief
    TrackKat.Branch
    TrackKat.Build
    TrackKat.Calibration
    TrackKat.Camera
    TrackKat.CommandLine
    TrackKat.Config
    TrackKat.Controls
    TrackKat.Display
    TrackKat.Frame
    TrackKat.GamePose
    TrackKat.Gesture
    TrackKat.Idle
    TrackKat.Lights
    TrackKat.Linear
    TrackKat.Log
    TrackKat.Match
    TrackKat.Number
    TrackKat.Old.Match
    TrackKat.Old.Tracker
    TrackKat.Old.Tracker.Absence
    TrackKat.Old.Tracker.Blobs
    TrackKat.Old.Tracker.Choose
    TrackKat.Old.Tracker.Follow
    TrackKat.Old.Tracker.Judge
    TrackKat.Old.Tracker.Layout
    TrackKat.Old.Tracker.Learners
    TrackKat.Old.Tracker.Mirror
    TrackKat.Old.Tracker.Outcome
    TrackKat.Old.Tracker.Sighting
    TrackKat.Old.Tracker.Sizes
    TrackKat.Old.Tracker.Still
    TrackKat.Old.Tracker.Trail
    TrackKat.Old.World
    TrackKat.Pose
    TrackKat.Protocol
    TrackKat.Recorder
    TrackKat.Recording
    TrackKat.Release
    TrackKat.Response
    TrackKat.ServedGame
    TrackKat.Session
    TrackKat.Shape
    TrackKat.Sight
    TrackKat.Stats
    TrackKat.Term
    TrackKat.Tracker
    TrackKat.Tracker.Absence
    TrackKat.Tracker.Account
    TrackKat.Tracker.Blobs
    TrackKat.Tracker.Choose
    TrackKat.Tracker.Follow
    TrackKat.Tracker.Layout
    TrackKat.Tracker.Learners
    TrackKat.Tracker.Mirror
    TrackKat.Tracker.Outcome
    TrackKat.Tracker.Presence
    TrackKat.Tracker.Reflectors
    TrackKat.Tracker.Sighting
    TrackKat.Tracker.Sizes
    TrackKat.Tracker.Still
    TrackKat.Tracker.Trail
    TrackKat.Trackers
    TrackKat.Tray
    TrackKat.Updater
    TrackKat.Visibility
    TrackKat.USB
    TrackKat.World
  build-depends:
    , array       ^>=0.5.8
    , async       ^>=2.2.6
    , base        ^>=4.22.0
    , bytestring  ^>=0.12.2
    , directory   ^>=1.3.10
    , filepath    ^>=1.5.4
    , text        ^>=2.1.3
    , zip-archive ^>=0.5
  c-sources:        cbits/usb_shim.c
  extra-libraries:  usb-1.0

  if os(windows)
    exposed-modules:
      TrackKat.Gui
      TrackKat.Gui.Tray
      TrackKat.Install
      TrackKat.Windows
    c-sources:
      cbits/gui.c
      cbits/install.c
      cbits/joystick.c
      cbits/npclient_common.c
      cbits/trackir.c
      cbits/windows.c
    include-dirs:    cbits
    build-depends:   Win32 ^>=2.14.2
    extra-libraries: advapi32 bcrypt gdi32 hid ole32 shell32 user32 winhttp

-- Simulated frames, for the tests: not part of trackkat itself.
library synth
  import:           shared
  hs-source-dirs:   synth
  exposed-modules:  TrackKat.Synth
  build-depends:
    , base
    , trackkat

executable tirprobe
  import:           shared
  hs-source-dirs:   app/tirprobe
  main-is:          Main.hs
  ghc-options:      -threaded -rtsopts
  build-depends:
    , async
    , base
    , directory
    , trackkat

flag icon
  description:
    Link icons/trackkat-icon.o, compiled from icons/trackkat.rc by windres,
    into trackkat.exe: its icon and the tray's.
  default:     False
  manual:      True

-- A GUI program (-mwindows), so it opens no console window however it is
-- started; it prints to the terminal it was started from, if any.
executable trackkat
  import:           shared
  hs-source-dirs:   app/trackkat
  main-is:          Main.hs
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-T" -optl-mwindows
  build-depends:
    , async
    , base
    , directory
    , filepath
    , time
    , trackkat

  if !os(windows)
    buildable: False

  if (os(windows) && flag(icon))
    ld-options: icons/trackkat-icon.o

-- Drives the window with a scripted pose, to work on it without a camera.
executable fakegui
  import:           shared
  hs-source-dirs:   app/fakegui
  main-is:          Main.hs
  ghc-options:      -threaded
  build-depends:
    , base
    , trackkat

  if !os(windows)
    buildable: False

test-suite tests
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
