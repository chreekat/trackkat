cabal-version:      3.0
name:               trackkat
version:            0.1.0.0
synopsis:           Replacement driver and control software for the TrackIR 5
license:            MIT
author:             chreekat
maintainer:         b@chreekat.net
build-type:         Simple
extra-doc-files:    README.md

common shared
  default-language: Haskell2010
  ghc-options:      -Wall

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    TrackKat.Calibration
    TrackKat.Camera
    TrackKat.Config
    TrackKat.Frame
    TrackKat.GamePose
    TrackKat.Linear
    TrackKat.Match
    TrackKat.Number
    TrackKat.Pose
    TrackKat.Protocol
    TrackKat.Response
    TrackKat.Stats
    TrackKat.Tracker
    TrackKat.USB
  build-depends:
    , array       ^>=0.5.8
    , async       ^>=2.2.6
    , base        ^>=4.22.0
    , bytestring  ^>=0.12.2
  c-sources:        cbits/usb_shim.c
  extra-libraries:  usb-1.0

  if os(windows)
    exposed-modules:
      TrackKat.Gui
      TrackKat.Windows
    c-sources:
      cbits/gui.c
      cbits/joystick.c
      cbits/npclient_common.c
      cbits/trackir.c
      cbits/windows.c
    include-dirs:    cbits
    extra-libraries: advapi32 gdi32 hid shell32 user32

executable tirprobe
  import:           shared
  hs-source-dirs:   app/tirprobe
  main-is:          Main.hs
  ghc-options:      -threaded -rtsopts
  build-depends:
    , async
    , base
    , trackkat

executable trackkat
  import:           shared
  hs-source-dirs:   app/trackkat
  main-is:          Main.hs
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-T"
  build-depends:
    , async
    , base
    , directory
    , filepath
    , time
    , trackkat

  if !os(windows)
    buildable: False

test-suite tests
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  build-depends:
    , base
    , bytestring
    , trackkat
