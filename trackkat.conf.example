# trackkat settings.
#
# Edit them in trackkat's window and click Save, or here in any text
# editor. They apply as soon as this file is saved, while trackkat
# runs. If a line has a mistake, trackkat names it and carries on with
# the settings it had. Saving from the window rewrites only the
# settings you changed there, and keeps the rest, comments included.
# Delete this file for a fresh one with every setting explained.
#
# Keys are like F12, Ctrl+F9, Alt+Shift+P, NumPad5. Joystick buttons
# are like Throttle - HOTAS Warthog button 23. In trackkat's window,
# Add key or button adds the next one you press. trackkat also prints
# the joystick buttons you press for a minute after it starts, and for
# a minute after you type j and Enter in its console, ready to copy
# here. Two controllers with the same name are told apart as Name (2),
# and so on. Joysticks plugged in while trackkat runs work at once.
#
# The middle and side mouse buttons are MouseMiddle, Mouse4 and Mouse5,
# with keys held or not, as in Ctrl+Mouse4; other programs still see
# them. The left and right buttons can't be bound. Windows can't see
# a gaming mouse's extra buttons until the mouse's own software gives
# them a key: give them F13 to F24, which no keyboard has, and bind
# those here.
#
# Separate several keys or buttons with commas:
#   recenter = F12, Throttle - HOTAS Warthog button 23
# Leave a setting empty for no keys or buttons.
#
# trim makes where you look in the game the new forward, for yaw and
# pitch, so you can look around from there; recentering undoes it.
# It has no keys or buttons unless you give it some:
#   trim = Ctrl+F12
recenter = F12
pause = F9
trim =

# Smoothing calms the view while your head is still, at the cost of
# some lag when you move. Both settings run from 0 to 100.
#
# steadiness: how still the view stays while your head is still. If
# the view jitters, raise it; if it feels floaty or drifts into place,
# lower it.
#
# responsiveness: how closely the view keeps up when you move. If it
# lags behind your head, raise it; if it jitters as you move slowly,
# lower it.
#
# smoothing = off turns smoothing off altogether.
smoothing = on
steadiness = 90
responsiveness = 45

# Response curves: how far the view turns or moves as your head does,
# the same both sides of centre. Most simply a multiplier, as 1:6: the
# view turns 6 degrees for each degree your head turns, so turning
# 30 degrees looks straight behind you.
#
# A centre precision, from 0 to 100, makes small movements gentler and
# large ones steeper, while the same head movement still reaches the
# end of the view: 180 degrees for yaw, 90 for pitch and roll, 300 mm
# for x, y and z. With precision p, near the centre the view moves
# 1 - p/100 times as far as the multiplier alone would, and at the end
# 1 + 2p/100 times. So yaw = 1:6, precision 40 still looks straight
# behind at 30 degrees, but a 5 degree glance turns the view 18 degrees
# rather than 30. For example:
#   yaw = 1:6, precision 40
#
# For any other shape, give input:output points: degrees for yaw, pitch
# and roll, mm for x, y and z. Straight lines join the points, starting
# from 0:0, and carry on past the last one. For example, a deadzone then
# 1:1 is 0.5:0 1.5:1, and 10:10 45:120 looks well behind you when you
# turn your head 45 degrees.
yaw = 1:6
pitch = 1:7
roll = 1:4
x = 1:3
y = 1:4
z = 1:2.5

# lean = view: leaning moves you relative to where you look in the
# game, so with the view turned to look behind you, leaning left looks
# out of the right side. Only turning left and right counts, not
# looking up or down. lean = screen: leaning moves you the same way
# whichever way you look.
lean = view

# clip: the headset clip's triangle of reflectors, in mm, measured
# centre to centre, with left and right as you wear it: your left to
# your right along the headband, your left to the top, then your
# right to the top. If the clip's post gets bent, measure it again
# and change this, or the view will be off.
clip = 70 110 110
